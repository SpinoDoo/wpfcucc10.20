<Window x:Class="AtletikaDataGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="KozepSzoveg" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BalSzoveg" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fejléc -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D" />
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" />
        </StackPanel>

        <!-- Bal oldali adatbeviteli panel -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <DockPanel LastChildFill="True">
                <Button x:Name="btnRegisztral" DockPanel.Dock="Bottom"
                        Content="REGISZTRÁL" Height="36" Background="#DDEBFA"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Margin="0,12,0,0"
                        Click="Regisztral_Click" />

                <StackPanel>
                    <TextBlock Text="Új versenyző" FontSize="20" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,12" />

                    <TextBlock Text="Versenyző neve:" Margin="0,0,0,4" />
                    <TextBox x:Name="txtNev" Height="32"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />

                    <TextBlock Text="Versenyszám:" Margin="0,12,0,4" />
                    <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False" SelectedIndex="-1"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="100 m" />
                        <ComboBoxItem Content="200 m" />
                        <ComboBoxItem Content="400 m" />
                        <ComboBoxItem Content="800 m" />
                        <ComboBoxItem Content="1500 m" />
                        <ComboBoxItem Content="Távolugrás" />
                        <ComboBoxItem Content="Magasugrás" />
                        <ComboBoxItem Content="Súlylökés" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Nem:" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <RadioButton x:Name="rbFerfi" GroupName="Nem" Content="Férfi"
                                     VerticalContentAlignment="Center" Margin="0,0,32,0" />
                        <RadioButton x:Name="rbNo" GroupName="Nem" Content="Nő"
                                     VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Életkor:" />
                        <TextBlock x:Name="txtEletkor" Text="18 év" FontWeight="Bold"
                                   Foreground="#1F5FA8" HorizontalAlignment="Right" Margin="0,0,16,0" />
                    </Grid>
                    <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18"
                            SmallChange="1" LargeChange="1"
                            TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                            Margin="0,6,0,0"
                            ValueChanged="Eletkor_Valtozott" />
                    <Grid>
                        <TextBlock Text="18" FontSize="12" Foreground="#52657A" HorizontalAlignment="Left" />
                        <TextBlock Text="90" FontSize="12" Foreground="#52657A" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D" Margin="0,16,0,6" />
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs (OR)" Margin="0,0,0,6" />
                    <CheckBox x:Name="chkVB" Content="Világcsúcs (VR)" Margin="0,0,0,6" />
                    <CheckBox x:Name="chkEB" Content="Európa-csúcs (ER)" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Igényelt rajtszám:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" x:Name="txtRajtszam" Height="32"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Üres mező: automatikus kiosztás." FontSize="12" Foreground="#52657A" Margin="0,8,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Jobb oldali terület -->
        <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Regisztrált versenyzők" FontSize="20" FontWeight="Bold"
                           Foreground="#19324D" Margin="0,0,0,12" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Eredményszűrő:" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox x:Name="cmbRekordSzuro" Width="360" Height="32" IsEditable="False"
                              VerticalContentAlignment="Center" SelectedIndex="0"
                              SelectionChanged="Szuro_Valtozott">
                        <ComboBoxItem Content="Összes" />
                        <ComboBoxItem Content="OR - olimpiai csúcs" />
                        <ComboBoxItem Content="VR - világcsúcs" />
                        <ComboBoxItem Content="ER - Európa-csúcs" />
                    </ComboBox>
                </StackPanel>

                <DataGrid Grid.Row="2" x:Name="dgVersenyzok"
                          ItemsSource="{Binding Versenyzok, Mode=OneWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="32" ColumnHeaderHeight="38"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E3E9F0"
                          AlternatingRowBackground="#F4F7FB" Background="White"
                          BorderBrush="#D4DDE7"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D9E8F8" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D9E8F8" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#19324D" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#19324D" />
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#19324D" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Width="88"
                                            Binding="{Binding Rajtszam, Mode=OneWay}"
                                            ElementStyle="{StaticResource KozepSzoveg}" />
                        <DataGridTextColumn Header="Név" Width="*"
                                            Binding="{Binding Nev, Mode=OneWay}"
                                            ElementStyle="{StaticResource BalSzoveg}" />
                        <DataGridTextColumn Header="Versenyszám" Width="160"
                                            Binding="{Binding Versenyszam, Mode=OneWay}"
                                            ElementStyle="{StaticResource BalSzoveg}" />
                        <DataGridTextColumn Header="Nem" Width="70"
                                            Binding="{Binding Nem, Mode=OneWay}"
                                            ElementStyle="{StaticResource KozepSzoveg}" />
                        <DataGridTextColumn Header="Életkor" Width="80"
                                            Binding="{Binding Eletkor, Mode=OneWay}"
                                            ElementStyle="{StaticResource KozepSzoveg}" />
                        <DataGridCheckBoxColumn Header="OR" Width="80"
                                                Binding="{Binding OR, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="VR" Width="80"
                                                Binding="{Binding VR, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="ER" Width="80"
                                                Binding="{Binding ER, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="12" Foreground="#52657A"
                           Text="OR = olimpiai csúcs     VR = világcsúcs     ER = Európa-csúcs" />
            </Grid>
        </Border>

        <!-- Lábléc -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txtLetszam" Text="Látható: 0 / Összesen: 0"
                           Foreground="#52657A" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnMentes" Content="FÁJLBA MENTÉS" Width="210" Height="32"
                            VerticalContentAlignment="Center" Click="Mentes_Click" />
                    <Button x:Name="btnBetoltes" Content="FÁJLBÓL BETÖLTÉS" Width="210" Height="32"
                            Margin="16,0,0,0" VerticalContentAlignment="Center" Click="Betoltes_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
